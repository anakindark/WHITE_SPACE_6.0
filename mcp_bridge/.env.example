# MCP server binds to loopback by default. Keep it private and use Secure MCP Tunnel.
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp

# WHITE_SPACE canonical API.
WS_API_BASE=http://127.0.0.1:8820
WS_HEALTH_PATH=/health
WS_STATE_PATH=/state
WS_QUEUE_PATH=/queue
WS_CAPABILITIES_PATH=/capabilities
WS_PROPOSAL_PATH=/proposals
WS_TIMEOUT_MS=5000
WS_MAX_RESPONSE_BYTES=1048576

# Fail closed unless the WHITE_SPACE API host is explicitly allowlisted.
# For a Mac -> PC LAN bridge, add the exact PC LAN address here.
WS_ALLOWED_API_HOSTS=127.0.0.1,localhost,::1,[::1]

# Read-only by default. Enable only when the ChatGPT plan/workspace supports
# custom MCP write actions and the PC-side proposal endpoint is ready.
WS_ENABLE_PROPOSALS=false

# Optional bearer token used only from this bridge to WHITE_SPACE.
# Do not commit the real value.
WS_BRIDGE_BEARER_TOKEN=
